<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeSwitch" Width="392" Height="580" MinWidth="340" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Focus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small square icon buttons (title bar, card menu) -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E5484D"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Account cards and big option buttons -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,10">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AddButton" TargetType="Button">
      <Setter Property="Height" Value="48"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="dash" RadiusX="12" RadiusY="12" Stroke="{DynamicResource Border}"
                         StrokeThickness="1.5" StrokeDashArray="4 3"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="dash" Property="Fill" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource IconFont}" FontSize="13" Width="24" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Border x:Name="track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                      Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Ellipse x:Name="thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                         Fill="{DynamicResource TextMuted}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tick box used in dialogs -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                      BorderBrush="{DynamicResource TextMuted}" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- System / Light / Dark picker -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="0,6" Margin="2">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                            Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Margin" Value="2,20,0,8"/>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
      <Setter Property="Margin" Value="0,12"/>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Background="{DynamicResource Border}" Margin="1,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Title bar ===== -->
    <Grid Grid.Row="0" Margin="14,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="22" Height="22" CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#5B6CF0" Offset="0"/>
              <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="ClaudeSwitch" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="Light / dark mode"/>
        <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"/>
        <Button x:Name="MinBtn" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" ToolTip="Minimize"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- ===== Account list ===== -->
    <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="16,4,16,16">

        <Border x:Name="PendingBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                         Foreground="{DynamicResource AccentFg}" VerticalAlignment="Center"/>
              <TextBlock Text="Sign in to your other account" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PendingText" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="PendingSaveBtn" Style="{StaticResource PrimaryButton}" Content="Save account" Padding="12,0" Margin="0,0,6,6"/>
              <Button x:Name="PendingTerminalBtn" Style="{StaticResource SecondaryButton}" Content="Claude Code login" Padding="12,0" Margin="0,0,6,6"/>
              <Button x:Name="PendingCancelBtn" Style="{StaticResource SecondaryButton}" Content="Cancel" Padding="12,0" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Grid Margin="2,6,2,10">
          <TextBlock Text="ACCOUNTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
          <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
        </Grid>

        <ItemsControl x:Name="AccountList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button x:Name="card" Style="{StaticResource CardButton}" Tag="card" ToolTip="{Binding Tip}"
                      AutomationProperties.Name="{Binding Name}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBrush}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border x:Name="pill" Grid.Column="2" Visibility="{Binding ActiveVisibility}" VerticalAlignment="Center"
                          Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="9,3">
                    <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFg}"/>
                  </Border>
                  <Button Grid.Column="3" Tag="menu" Style="{StaticResource IconButton}" Content="&#xE712;"
                          Margin="4,0,-4,0" ToolTip="More" AutomationProperties.Name="More"/>
                </Grid>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="EmptyState" Style="{StaticResource Panel}" Padding="20,26" Margin="0,0,0,10">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="22"
                         Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No accounts yet" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Text="Add your Claude accounts once. Then switch between them with one click."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMuted}"
                       Margin="0,6,0,0" MaxWidth="250" LineHeight="19"/>
          </StackPanel>
        </Border>

        <Button x:Name="AddBtn" Style="{StaticResource AddButton}" AutomationProperties.Name="Add account">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="Add account" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Footer ===== -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,9">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <StackPanel x:Name="DesktopStatus" Orientation="Horizontal" Background="Transparent">
            <Ellipse x:Name="DesktopDot" Width="7" Height="7" VerticalAlignment="Center"/>
            <TextBlock x:Name="DesktopLabel" Margin="6,0,14,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
          </StackPanel>
          <StackPanel x:Name="CodeStatus" Orientation="Horizontal" Background="Transparent">
            <Ellipse x:Name="CodeDot" Width="7" Height="7" VerticalAlignment="Center"/>
            <TextBlock x:Name="CodeLabel" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
      </Grid>
    </Border>

    <!-- ===== Settings ===== -->
    <Grid x:Name="SettingsLayer" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Bg}" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,0,16,18">
          <StackPanel Orientation="Horizontal" Margin="-6,0,0,0">
            <Button x:Name="SettingsBackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back"/>
            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>

          <TextBlock Style="{StaticResource SectionLabel}" Text="APPEARANCE" Margin="2,14,0,8"/>
          <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="2">
            <UniformGrid Columns="3">
              <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="System"/>
              <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="Light"/>
              <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="Dark"/>
            </UniformGrid>
          </Border>

          <TextBlock Style="{StaticResource SectionLabel}" Text="CLAUDE DESKTOP"/>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <CheckBox x:Name="ManageDesktopToggle" Style="{StaticResource Toggle}" Content="Switch Claude Desktop"/>
              <Border Style="{StaticResource Divider}"/>
              <CheckBox x:Name="ReopenToggle" Style="{StaticResource Toggle}" Content="Open Claude after switching"/>
              <Border Style="{StaticResource Divider}"/>
              <TextBlock Text="Data folder" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
              <TextBlock x:Name="DesktopPathText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="DesktopFolderBtn" Style="{StaticResource SmallButton}" Content="Change…" Margin="0,0,6,0"/>
                <Button x:Name="DesktopAutoBtn" Style="{StaticResource SmallButton}" Content="Find automatically"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionLabel}" Text="CLAUDE CODE"/>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <CheckBox x:Name="ManageCodeToggle" Style="{StaticResource Toggle}" Content="Switch Claude Code (CLI)"/>
              <Border Style="{StaticResource Divider}"/>
              <TextBlock Text="Sign-in file" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
              <TextBlock x:Name="CodePathText" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionLabel}" Text="YOUR DATA"/>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMuted}" LineHeight="18"
                         Text="Saved sign-ins stay on this PC. Claude Code tokens are encrypted so only your Windows account can read them. Nothing is sent anywhere."/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="OpenDataBtn" Style="{StaticResource SmallButton}" Content="Open data folder"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock x:Name="AboutText" TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5"
                     Foreground="{DynamicResource TextMuted}" Margin="0,22,0,0" LineHeight="18"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===== Toast ===== -->
    <Border x:Name="Toast" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="16,0,16,52" Padding="14,9" CornerRadius="10" Background="{DynamicResource ToastBg}"
            Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastText}" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <!-- ===== Dialog ===== -->
    <Grid x:Name="DialogLayer" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Grid VerticalAlignment="Center" Margin="16" MaxWidth="360">
        <Border CornerRadius="14" Background="{DynamicResource Surface}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" Color="Black"/>
          </Border.Effect>
        </Border>
        <Border x:Name="DialogCard" CornerRadius="14" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Background="{DynamicResource Surface}" Padding="18,16" KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel>
            <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel x:Name="DialogBody" Margin="0,8,0,0"/>
            <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Working... ===== -->
    <Grid x:Name="BusyLayer" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
              CornerRadius="14" Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
        <StackPanel Orientation="Horizontal">
          <Path Width="26" Height="26" Stroke="{DynamicResource Accent}" StrokeThickness="3"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 13,2 A 11,11 0 1 1 2,13"
                RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
            <Path.RenderTransform>
              <RotateTransform/>
            </Path.RenderTransform>
            <Path.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:0.9"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Path.Triggers>
          </Path>
          <TextBlock x:Name="BusyText" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== Account "more" menu ===== -->
    <Popup x:Name="CardMenu" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
      <Grid Margin="10,4,10,14">
        <Border CornerRadius="10" Background="{DynamicResource Surface}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black"/>
          </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="10" Padding="4" Width="200">
          <StackPanel>
            <Button x:Name="MenuRename" Style="{StaticResource MenuButton}" Tag="&#xE8AC;" Content="Rename"/>
            <Button x:Name="MenuUpdate" Style="{StaticResource MenuButton}" Tag="&#xE72C;" Content="Update saved sign-in"/>
            <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
            <Button x:Name="MenuDelete" Style="{StaticResource MenuButton}" Tag="&#xE74D;" Content="Remove"
                    Foreground="{DynamicResource Danger}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Popup>
  </Grid>
</Window>
